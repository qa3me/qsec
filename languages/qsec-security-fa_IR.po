msgid "Source code on GitHub"
msgstr "کد منبع در گیت‌هاب"

msgid "Recovery mode is active. Qsec previews, sign-in protection, firewall and hardening are paused."
msgstr "حالت بازیابی فعال است. پیش‌نمایش‌ها، محافظت از ورود، فایروال و سخت‌سازی کیوسِک متوقف شده‌اند."

msgid "Local firewall"
msgstr "فایروال محلی"

msgid "Inspects public GET and HEAD page paths that reach WordPress for configuration files, their backups and version-control metadata. Form submissions, login and the WordPress REST API follow their normal routes."
msgstr "مسیر درخواست‌های عمومی GET و HEAD که به وردپرس می‌رسند برای فایل‌های پیکربندی، پشتیبان آن‌ها و فرادادهٔ مخزن کد بررسی می‌شود. ارسال فرم، ورود و REST API وردپرس از مسیر معمول خود اجرا می‌شوند."

msgid "Firewall mode"
msgstr "حالت فایروال"

msgid "Report only (default)"
msgstr "فقط گزارش (پیش‌فرض)"

msgid "Block and report"
msgstr "مسدودسازی و گزارش"

msgid "Off"
msgstr "خاموش"

msgid "Save firewall mode"
msgstr "ذخیرهٔ حالت فایروال"

msgid "Reports contain only rule totals for the last seven UTC days. The counter for each rule and mode stops at 1,000 per day."
msgstr "گزارش فقط شمار رخداد هر قاعده را برای هفت روز اخیر بر اساس UTC نگه می‌دارد. شمارش هر قاعده و حالت به ۱٬۰۰۰ رخداد در روز محدود است."

msgid "Firewall report"
msgstr "گزارش فایروال"

msgid "Rule"
msgstr "قاعده"

msgid "Reported"
msgstr "گزارش‌شده"

msgid "Blocked"
msgstr "مسدودشده"

msgid "Configuration file"
msgstr "فایل پیکربندی"

msgid "Repository metadata"
msgstr "فرادادهٔ مخزن کد"

msgid "Clear firewall report"
msgstr "پاک‌کردن گزارش فایروال"

msgid "No firewall events in this period."
msgstr "در این بازه رخدادی برای فایروال ثبت نشده است."

msgid "This request was blocked."
msgstr "این درخواست مسدود شد."

msgid "You do not have permission to clear firewall reports."
msgstr "شما اجازهٔ پاک‌کردن گزارش فایروال را ندارید."

msgid "Too many sign-in attempts. Wait a minute and try again."
msgstr "تعداد تلاش‌های ورود زیاد است. یک دقیقه صبر کنید و دوباره تلاش کنید."

msgid "Recovery mode is active. Qsec previews, sign-in protection and hardening are paused."
msgstr "حالت بازیابی فعال است. پیش‌نمایش‌ها، محافظت از ورود و سخت‌سازی کیوسِک متوقف شده‌اند."

msgid "Animate the shield and its four points in light and dark designs"
msgstr "حرکت سپر و چهار نقطهٔ اطراف آن در طرح روشن و تیره"

msgid "Login attempts"
msgstr "تلاش‌های ورود"

msgid "Reports show daily totals for the last seven UTC days. They contain no usernames, addresses or passwords."
msgstr "گزارش، تعداد تلاش‌های هفت روز اخیر را بر اساس زمان UTC نشان می‌دهد؛ بدون نام کاربری، نشانی شبکه و رمز عبور."

msgid "Record failed sign-ins locally"
msgstr "ثبت محلی ورودهای ناموفق"

msgid "Limit repeated password attempts"
msgstr "محدودکردن تلاش‌های پشت‌سرهم برای ورود با رمز"

msgid "Five failures in five minutes pause the same login name and source for one minute. Retries do not extend the wait. Password recovery and existing sessions remain available."
msgstr "پنج تلاش ناموفق در پنج دقیقه، ورود با همان نام و از همان مبدأ را یک دقیقه متوقف می‌کند. تلاش دوباره این مدت را بیشتر نمی‌کند. بازیابی رمز و نشست‌های فعلی در دسترس‌اند."

msgid "Save login protection"
msgstr "ذخیرهٔ محافظت از ورود"

msgid "Failed sign-in report"
msgstr "گزارش ورودهای ناموفق"

msgid "Date (UTC)"
msgstr "تاریخ (UTC)"

msgid "Password failures"
msgstr "خطای ورود با رمز"

msgid "Second-factor failures"
msgstr "خطای کد دومرحله‌ای"

msgid "Limited requests"
msgstr "تلاش‌های محدودشده"

msgid "No recorded attempts in this period."
msgstr "در این بازه تلاشی ثبت نشده است."

msgid "Clear reports and temporary limits"
msgstr "پاک‌کردن گزارش و رفع محدودیت‌های موقت"

msgid "You do not have permission to clear login reports."
msgstr "شما اجازهٔ پاک‌کردن گزارش‌های ورود را ندارید."

msgid "© %s Behzad Qasemi · Qsec"
msgstr "© %s بهزاد قاسمی · کیوسِک"

msgid "Choose a design for the WordPress login and recovery screens."
msgstr "طرح صفحهٔ ورود و بازیابی رمز وردپرس را انتخاب کنید."

msgid "Preview dark green"
msgstr "پیش‌نمایش سبز تیره"

msgid "Preview light"
msgstr "پیش‌نمایش روشن"

msgid "Login appearance"
msgstr "ظاهر صفحه ورود"

msgid "Standard WordPress"
msgstr "ظاهر استاندارد وردپرس"

msgid "Dark green"
msgstr "سبز تیره"

msgid "Light"
msgstr "روشن"

msgid "Match device appearance"
msgstr "هماهنگ با ظاهر دستگاه"

msgid "Classic branding"
msgstr "طرح کلاسیک"

msgid "Classic accent (optional, e.g. #1a5e79)"
msgstr "رنگ تأکیدی طرح کلاسیک (اختیاری، مثل ‎#1a5e79‎)"

msgid "Animate the shield once in light and dark designs"
msgstr "سپر در طرح روشن و تیره یک‌بار حرکت کند"

msgid "Show the author copyright in light and dark designs"
msgstr "نمایش حق‌نشر بهزاد قاسمی در طرح روشن و تیره"

msgid "Public registration"
msgstr "ثبت‌نام عمومی"

msgid "Closed in WordPress"
msgstr "در وردپرس بسته است"

msgid "Open in WordPress"
msgstr "در وردپرس باز است"

msgid "Review access: the default role has additional privileges"
msgstr "دسترسی‌ها را بررسی کنید. نقش پیش‌فرض اختیارات بیشتری دارد."

msgid "Open, but the default role is unknown"
msgstr "ثبت‌نام باز است. نقش پیش‌فرض مشخص نیست."

msgid "Default role: %s"
msgstr "نقش پیش‌فرض %s"

msgid "%1$s of %2$s enrolled"
msgstr "%1$s از %2$s حساب فعال"

msgid "%s (partial)"
msgstr "%s (پوشش ناقص)"

msgid "%s pending"
msgstr "%s به‌روزرسانی در انتظار"

msgid "A bounded, read-only inspection for suspicious PHP and embedded code. Optional SHA-256 digests match a trusted list you provide."
msgstr "بازرسی محدود و فقط‌خواندنی برای PHP مشکوک و کد جاسازی‌شده. می‌توانید هش‌های SHA-256 را از فهرست مورداعتماد خود وارد کنید."

msgid "A core scan is already in progress. Resume it or discard it first."
msgstr "یک اسکن هسته در جریان است. ابتدا آن را ادامه دهید یا کنار بگذارید."

msgid "A report-only starter policy is active for this request. Review browser developer tools for violations."
msgstr "سیاست اولیهٔ فقط‌گزارش در این درخواست فعال است. موارد ناسازگار را در ابزار توسعهٔ مرورگر ببینید."

msgid "Accent (optional, e.g. #1a5e79)"
msgstr "رنگ تأکیدی (اختیاری، مثل ‎#1a5e79)"

msgid "Activate the optional Two-Factor plugin to use authenticator codes and backup codes with the native WordPress login."
msgstr "افزونهٔ اختیاری Two-Factor را فعال کنید تا در ورود وردپرس از کد احراز هویت و کد پشتیبان استفاده کنید."

msgid "Administrator two-factor enrollment"
msgstr "فعال‌سازی ورود دومرحله‌ای مدیران"

msgid "An existing report-only policy was detected. It remains in place."
msgstr "یک سیاست فقط‌گزارش وجود دارد و همچنان برقرار است."

msgid "Applies to the built-in theme and plugin code editors. Core updates and plugin management remain available."
msgstr "روی ویرایشگرهای داخلی کد قالب و افزونه اعمال می‌شود. به‌روزرسانی هسته و مدیریت افزونه‌ها برقرار می‌مانند."

msgid "Based on current WordPress settings"
msgstr "بر پایهٔ تنظیمات فعلی وردپرس"

msgid "Breakdown of configuration checks by status"
msgstr "تفکیک بررسی‌های تنظیمات بر اساس وضعیت"

msgid "Cached data is older than 24 hours"
msgstr "اطلاعات ذخیره‌شده بیش از ۲۴ ساعت قدمت دارد"

msgid "Checks passed"
msgstr "بررسی‌های موفق"

msgid "Choose a valid malware inspection scope."
msgstr "محدودهٔ معتبری برای بازرسی بدافزار انتخاب کنید."

msgid "Choose Qsec CSP preview in the front-end admin bar on other pages. The preview reports violations without blocking resources."
msgstr "برای صفحه‌های دیگر، پیش‌نمایش CSP کیوسِک را در نوار مدیریت سایت انتخاب کنید. پیش‌نمایش موارد ناسازگار را گزارش می‌کند و منابع صفحه بارگیری می‌شوند."

msgid "Clear core report"
msgstr "پاک‌کردن گزارش هسته"

msgid "Clear scan history"
msgstr "پاک‌کردن تاریخچهٔ اسکن"

msgid "Compare WordPress core files"
msgstr "مقایسهٔ فایل‌های هستهٔ وردپرس"

