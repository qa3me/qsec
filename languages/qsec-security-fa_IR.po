msgstr "پیش‌نمایش CSP کیوسِک"

msgid "Qsec"
msgstr "کیوسِک"

msgid "No findings in the inspected portion."
msgstr "بخش بررسی‌شده یافته‌ای نداشت."

msgid "No local update data"
msgstr "اطلاعات به‌روزرسانی در دسترس نیست"

msgid "No scan"
msgstr "اسکن نشده"

msgid "No scans yet. Run a file scan to start tracking findings."
msgstr "هنوز اسکن انجام نشده است. برای ثبت یافته‌ها یک اسکن فایل اجرا کنید."

msgid "Observations requiring manual review:"
msgstr "موارد نیازمند بررسی دستی:"

msgid "Open WordPress.org reference"
msgstr "بازکردن مرجع WordPress.org"

msgid "Partial coverage. A limit was reached or some locations could not be inspected."
msgstr "پوشش ناقص است. اسکن به سقف رسیده یا خواندن بعضی مسیرها ممکن نبوده است."

msgid "Passed"
msgstr "موفق"

msgid "Paste the official checksum JSON for the installed version and locale. Qsec compares the reference locally."
msgstr "JSON رسمی checksum همین نسخه و زبان وردپرس را وارد کنید. کیوسِک مقایسه را روی همین سایت انجام می‌دهد."

msgid "Pause after this batch"
msgstr "مکث بعد از این دسته"

msgid "PHP marker in a media file"
msgstr "نشانگر PHP در فایل رسانه‌ای"

msgid "Plugins"
msgstr "افزونه‌ها"

msgid "Potentially executable file extension"
msgstr "پسوند فایل احتمالاً اجرایی است"

msgid "Preview on the home page"
msgstr "پیش‌نمایش صفحهٔ اصلی"

msgid "Public URL uses HTTPS"
msgstr "نشانی عمومی سایت از HTTPS استفاده می‌کند"

msgid "Read the site’s current headers and preview a draft Content Security Policy. Compare the pages that use different styles, fonts, scripts or APIs."
msgstr "هدرهای فعلی سایت را ببینید و پیش‌نویس CSP را امتحان کنید. صفحه‌هایی با استایل، فونت، اسکریپت یا API متفاوت را مقایسه کنید."

msgid "Reading response headers…"
msgstr "در حال خواندن هدرهای پاسخ…"

msgid "Recovery mode"
msgstr "حالت بازیابی"

msgid "Recovery mode is active. Preview, login styling and Qsec hardening are suspended."
msgstr "حالت بازیابی فعال است. پیش‌نمایش، ظاهر ورود و سخت‌سازی کیوسِک موقتاً غیرفعال‌اند."

msgid "Refresh draft"
msgstr "به‌روزرسانی پیش‌نویس"

msgid "Review"
msgstr "بررسی"

msgid "Review hardening controls"
msgstr "مشاهدهٔ تنظیمات سخت‌سازی"

msgid "Review security headers, inspect files and manage WordPress safeguards from this site."
msgstr "هدرهای امنیتی را بررسی کنید، فایل‌ها را بازرسی کنید و حفاظت وردپرس را از همین سایت مدیریت کنید."

msgid "Review update information already on this site and the two-factor status of administrators. The review runs when requested."
msgstr "اطلاعات به‌روزرسانیِ موجود در سایت و وضعیت ورود دومرحله‌ای مدیران را ببینید. بررسی با درخواست شما اجرا می‌شود."

msgid "Run a scan to start your history"
msgstr "برای شروع تاریخچه یک اسکن اجرا کنید"

msgid "Run malware inspection"
msgstr "اجرای بازرسی بدافزار"

msgid "Run next batch"
msgstr "اجرای دستهٔ بعدی"

msgid "Run security review"
msgstr "اجرای مرور امنیتی"

msgid "Save hardening controls"
msgstr "ذخیرهٔ تنظیمات سخت‌سازی"

msgid "Save login branding"
msgstr "ذخیرهٔ ظاهر ورود"

msgid "Scan history cleared."
msgstr "تاریخچهٔ اسکن پاک شد."

msgid "Scan paused. Reload this page to resume from the latest saved batch."
msgstr "اسکن متوقف شد. برای ادامه از آخرین دستهٔ ذخیره‌شده، صفحه را دوباره بارگذاری کنید."

msgid "Scans read local files and report findings for review. Qsec stores counts and coverage, and leaves the files in place."
msgstr "اسکن فایل‌های محلی را می‌خواند و یافته‌ها را گزارش می‌کند. کیوسِک تعداد و پوشش را ذخیره می‌کند و فایل‌ها را دست‌نخورده می‌گذارد."

msgid "Security headers"
msgstr "هدرهای امنیتی"

msgid "Security overview"
msgstr "نمای کلی امنیت"

msgid "Security review and export"
msgstr "مرور امنیتی و خروجی گزارش"

msgid "See recommendations below"
msgstr "پیشنهادها را در پایین ببینید"

msgid "Set up an authenticator app in your WordPress profile and save the backup codes somewhere private."
msgstr "برنامهٔ احراز هویت را در پروفایل وردپرس راه‌اندازی کنید و کدهای پشتیبان را در جای امن نگه دارید."

msgid "Seven-day file findings bar chart"
msgstr "نمودار میله‌ای یافته‌های فایل در هفت روز"

msgid "Site security"
msgstr "امنیت سایت"

msgid "Start core scan"
msgstr "شروع اسکن هسته"

msgid "Stops pingback requests and leaves the other XML-RPC methods available."
msgstr "درخواست‌های پینگ‌بک مسدود می‌شوند و دیگر روش‌های XML-RPC برقرار می‌مانند."

msgid "Style the WordPress login and recovery screens with your site’s title and accent. Clear the title to restore the standard look."
msgstr "عنوان و رنگ سایت را به صفحه‌های ورود و بازیابی رمز اضافه کنید. با پاک‌کردن عنوان، ظاهر استاندارد برمی‌گردد."

msgid "Suspicious: code execution and decoding in the same PHP sample"
msgstr "مشکوک: اجرای کد و رمزگشایی در یک نمونهٔ PHP"

msgid "Suspicious: executable extension in uploads"
msgstr "مشکوک: پسوند اجرایی در آپلودها"

msgid "Suspicious: PHP marker in a media file"
msgstr "مشکوک: نشانگر PHP در فایل رسانه‌ای"

msgid "The download contains counts and coverage. It excludes account names, site URLs, file paths and secrets."
msgstr "گزارش شامل تعدادها و پوشش بررسی است. نام حساب‌ها، نشانی سایت، مسیر فایل‌ها و اطلاعات محرمانه در آن درج نمی‌شوند."

msgid "The first 60 findings are listed."
msgstr "۶۰ یافتهٔ اول فهرست شده‌اند."

msgid "The header probe failed. Inspect the page response in the browser’s Network tab."
msgstr "خواندن هدرها انجام نشد. هدرهای پاسخ را در زبانهٔ Network مرورگر ببینید."

msgid "The probe reads a HEAD response from this page. Your host may send different headers for GET requests."
msgstr "ابزار، پاسخ HEAD همین صفحه را می‌خواند. هاست ممکن است برای درخواست GET هدرهای دیگری بفرستد."

msgid "The scan changed or expired. Use the current progress below."
msgstr "اسکن تغییر کرده یا منقضی شده است. از پیشرفت فعلی که پایین می‌بینید ادامه دهید."

msgid "Themes"
msgstr "قالب‌ها"

msgid "This draft reflects resources observed in one page load. Inline code, late requests and other pages require separate review. Refresh the draft after interacting with the page."
msgstr "پیش‌نویس بر پایهٔ منابع دیده‌شده در یک بار بارگیری است. کد درون‌خطی، درخواست‌های دیرهنگام و صفحه‌های دیگر جدا بررسی می‌شوند. بعد از کار با صفحه، پیش‌نویس را تازه کنید."

msgid "Title"
msgstr "عنوان"

msgid "Trusted SHA-256 digests (optional)"
msgstr "هش‌های معتبر SHA-256 (اختیاری)"

msgid "Two-factor authentication"
msgstr "ورود دومرحله‌ای"

msgid "Two-factor is available. Your account is not enrolled."
msgstr "ورود دومرحله‌ای در دسترس است. هنوز برای حساب شما فعال نشده است."

msgid "Two-factor is enabled for your account."
msgstr "ورود دومرحله‌ای برای حساب شما فعال است."

msgid "Two-Factor is unavailable"
msgstr "افزونهٔ Two-Factor در دسترس نیست"

msgid "Uploads"
msgstr "آپلودها"

msgid "Uploads, core and malware are separate series. A short line marks zero findings, and a gap means no scan. Details are listed in the data table."
msgstr "آپلودها، هسته و بدافزار جدا نمایش داده می‌شوند. خط کوتاه یعنی صفر یافته و فضای خالی یعنی اسکن نشده. جزئیات در جدول داده‌ها آمده است."

msgid "View chart data"
msgstr "نمایش داده‌های نمودار"

msgid "WordPress core"
msgstr "هستهٔ وردپرس"

msgid "WordPress debug display is off"
msgstr "نمایش خطاهای عیب‌یابی وردپرس خاموش است"

msgid "You do not have permission to export this report."
msgstr "شما اجازهٔ دریافت این گزارش را ندارید."

msgid "Local security dashboard, file integrity, header preview and WordPress hardening."
msgstr "پیشخوان امنیتی محلی، یکپارچگی فایل‌ها، پیش‌نمایش هدرها و سخت‌سازی وردپرس."
