msgstr "دریافت Two-Factor از WordPress.org"

msgid "Hardening controls"
msgstr "تنظیمات سخت‌سازی"

msgid "Hollow bar = partial coverage"
msgstr "میلهٔ توخالی یعنی پوشش ناقص"

msgid "Info"
msgstr "اطلاع"

